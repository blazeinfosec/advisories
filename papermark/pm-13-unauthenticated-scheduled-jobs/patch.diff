From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julio Fort <julio.fort@blazeinfosec.com>
Date: Sun, 08 Nov 2026 12:00:00 +0100
Subject: [PATCH] Fail closed when the QStash signature is absent off Vercel

verifyQstashSignature and four inline cron handlers skipped signature
verification unless process.env.VERCEL === "1", leaving every scheduled job
and the webhook callback unauthenticated on self-hosted deployments. Remove
the VERCEL gate and fail closed when the Upstash-Signature is missing or
invalid.
---
diff --git a/app/api/cron/dataroom-digest/daily/route.ts b/app/api/cron/dataroom-digest/daily/route.ts
index e70ee1ed..8eb4cad4 100644
--- a/app/api/cron/dataroom-digest/daily/route.ts
+++ b/app/api/cron/dataroom-digest/daily/route.ts
@@ -9,7 +9,13 @@ export const maxDuration = 300;
 
 export async function POST(req: Request) {
   const body = await req.json();
-  if (process.env.VERCEL === "1") {
+  // Verify on every deployment and fail closed when unconfigured. The previous
+  // `if (process.env.VERCEL === "1")` wrapper skipped verification on every
+  // non-Vercel deployment, including production self-hosting.
+  if (!process.env.QSTASH_CURRENT_SIGNING_KEY) {
+    return new Response("Unauthorized", { status: 401 });
+  }
+  {
     const isValid = await receiver.verify({
       signature: req.headers.get("Upstash-Signature") || "",
       body: JSON.stringify(body),
