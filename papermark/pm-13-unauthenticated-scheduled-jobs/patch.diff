diff --git a/lib/cron/verify-qstash.ts b/lib/cron/verify-qstash.ts
index efc0d731..8f304320 100644
--- a/lib/cron/verify-qstash.ts
+++ b/lib/cron/verify-qstash.ts
@@ -8,9 +8,12 @@ export const verifyQstashSignature = async ({
   req: Request;
   rawBody: string; // Make sure to pass the raw body not the parsed JSON
 }) => {
-  // skip verification in local development
-  if (process.env.VERCEL !== "1") {
-    return;
+  // Verify the signature on every deployment. The previous check returned early
+  // whenever VERCEL !== "1", which is every non-Vercel deployment — including
+  // production self-hosting — so the signature was never verified there. Fail
+  // closed when no signing key is configured rather than accepting unsigned calls.
+  if (!process.env.QSTASH_CURRENT_SIGNING_KEY) {
+    throw new Error("QStash signing key is not configured.");
   }
 
   const signature = req.headers.get("Upstash-Signature");
