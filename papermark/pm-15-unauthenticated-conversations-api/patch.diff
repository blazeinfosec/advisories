+
+import { getDataroomSessionByLinkIdInPagesRouter } from "@/lib/auth/dataroom-auth";
 import prisma from "@/lib/prisma";
 
 import {
@@ -13,18 +16,42 @@ import { messageService } from "../lib/api/messages";
 import { notificationService } from "../lib/api/notifications";
 import { sendConversationTeamMemberNotificationTask } from "../lib/trigger/conversation-message-notification";
 
+// Resolve the caller's identity from their dataroom session cookie instead of
+// trusting a viewerId supplied in the request. The per-link session cookie
+// (pm_drs_<linkId>) is keyed in Redis to a server-stored session that records the
+// authenticated viewerId and dataroomId; we accept only a session bound to the
+// dataroom in question. Returns the authenticated viewerId, or null.
+async function resolveSessionViewer(
+  req: NextApiRequest,
+  dataroomId: string,
+): Promise<string | null> {
+  const cookies = parse(req.headers.cookie || "");
+  for (const name of Object.keys(cookies)) {
+    if (!name.startsWith("pm_drs_")) continue;
+    const linkId = name.slice("pm_drs_".length);
+    const session = await getDataroomSessionByLinkIdInPagesRouter(req, linkId);
+    if (session && session.dataroomId === dataroomId && session.viewerId) {
+      return session.viewerId;
+    }
+  }
+  return null;
+}
